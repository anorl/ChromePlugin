{
  "manifest_version": 3,
  "name": "自动打开并感谢",
  "version": "1.6.0",
  "description": "按设定的 page 范围访问可配置的列表页模板，依次打开每个 details.php?id=...，自动点击“说谢谢”后立即关闭；带访问日志与面板控制/状态显示。",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["https://*/", "http://*/"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "自动打开并感谢"
  },
  "background": {
    "service_worker": "background.js"
  }
}
