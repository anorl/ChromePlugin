{
  "manifest_version": 3,
  "name": "HDSky Range Opener",
  "version": "1.3.0",
  "description": "按大小依次打开 HDSky 列表页中的“下载本种”页面，带进度与一键停止。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "按大小依次打开下载页"
  },
  "permissions": [
    "tabs",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://hdsky.me/*",
    "https://*.hdsky.me/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://hdsky.me/torrents.php*","https://*.hdsky.me/torrents.php*"],
      "js": ["content/list-page.js"],
      "run_at": "document_idle"
    }
  ]
}
