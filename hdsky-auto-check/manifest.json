{
  "manifest_version": 3,
  "name": "HDSky 下载页自动勾选",
  "version": "1.0.0",
  "description": "仅在 downloadnotice 页面自动勾选「我会提高分享率的」。",
  "permissions": ["storage"],
  "host_permissions": ["https://hdsky.me/*", "https://*.hdsky.me/*"],
  "action": {
    "default_title": "HDSky 自动勾选",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://hdsky.me/downloadnotice.php*"],
      "js": ["content/auto-check.js"],
      "run_at": "document_idle"
    }
  ]
}
