 {
   "manifest_version": 3,
   "name": "HDSky 批量自动下载种子",
   "version": "1.0.0",
   "description": "在 torrents 列表页批量点击【下载本种】，在 notice 页自动勾选并下载 .torrent。",
   "permissions": [
     "scripting",
     "tabs",
     "downloads",
     "storage"
   ],
   "host_permissions": [
     "https://hdsky.me/*",
     "https://*.hdsky.me/*"
   ],
   "background": {
     "service_worker": "background.js"
   },
   "options_page": "options.html",
   "content_scripts": [
     {
       "matches": ["https://hdsky.me/torrents.php*"],
       "js": ["content/list-page.js"],
       "css": ["content/inject.css"],
       "run_at": "document_idle"
     },
     {
       "matches": ["https://hdsky.me/downloadnotice.php*"],
       "js": ["content/notice-page.js"],
       "run_at": "document_idle"
     }
   ],
  "icons": {}
 }
