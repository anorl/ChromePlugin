{
  "manifest_version": 3,
  "name": "自动签到",
  "version": "1.2.1",
  "description": "按日定时执行代码化任务：打开页面、点击按钮、等待成功并关闭；支持5秒超时、任务状态展示与停止运行。",
  "permissions": ["alarms", "tabs", "scripting", "storage", "notifications"],
  "host_permissions": [
    "https://hhanclub.top/*",
    "https://ourbits.club/*",
    "https://audiences.me/*",
    "https://kp.m-team.cc/*",
    "https://ptchdbits.co/*",
    "https://springsunday.net/*"
  ],

  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },

  "background": { "service_worker": "background.js" },

  "action": {
    "default_title": "自动签到",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}
